#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! command -v python3 >/dev/null 2>&1; then
    echo "La génération de la version simplifiée nécessite Python 3." >&2
    exit 1
fi
# Lire également le générateur depuis l’index : tout correspond au commit.
generator=$(mktemp)
trap 'rm -f "$generator"' EXIT HUP INT TERM
git show :scripts/generate-static.py > "$generator"
python3 "$generator" --staged
git add -- version-simplifiee.html version.json
